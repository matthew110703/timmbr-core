model InvoiceSequence {
  series        String   @id
  sellerGstin   String   @db.VarChar(15)
  financialYear String   @db.VarChar(5)
  prefix        String   @db.VarChar(3)
  lastValue     Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([sellerGstin, financialYear, prefix])
}

