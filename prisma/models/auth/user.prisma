enum UserRole {
    USER
    STAFF
    ADMIN
    MASTER
}

enum UserStatus {
    ACTIVE
    DELETED
}

model User {
    id String @id @default(uuid())
    role UserRole @default(USER)
    status UserStatus @default(ACTIVE)
    name String
    email String @unique
    phone String? @unique
    emailVerified  Boolean @default(false) @map("email_verified")
    password String? 
    permissions String[] @default([])
    lastLoginAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    providers UserProvider[]
    address Address[]
    orders Order[]
    carts Cart[]
    wishlist Wishlist?
    voidedInvoices Invoice[] @relation("VoidedInvoices")
    acknowledgedOrders Order[] @relation("AcknowledgedOrders")
    orderActivities OrderActivity[]
    reviews Review[]
    reviewHelpfulVotes ReviewHelpfulVote[]
    reviewModerationEvents ReviewModerationEvent[] @relation("ReviewModerationActor")
}
