enum VariantStatus {
  ACTIVE       // Live and visible on storefront; purchasable when available stock > 0
  DISCONTINUED // Permanently retired / end-of-life; visible for history but not purchasable
  HIDDEN       // Unpublished / draft variant hidden from customer storefront
}

model ProductVariant {
  id             String        @id @default(uuid())
  productId      String
  sku            String        @unique
  price          Decimal
  isDefault      Boolean       @default(false)
  status         VariantStatus @default(ACTIVE)
  currency       String        @default("INR")
  compareAtPrice Decimal?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  product         Product          @relation(fields: [productId], references: [id])
  inventory       Inventory?
  images          ProductImage[]
  attributeValues AttributeValue[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
}
