# Server
PORT=8000
NODE_ENV=dev
LOG_FORMAT=pretty # Options: pretty, json (defaults to pretty in dev, json in prod)

# Database (PostgreSQL connection string)
DATABASE_URL=

# Client apps (comma-separated origins; CORS allows all of them).
# The FIRST origin of each list is also that app's public URL:
#   storefront    → Google sign-in lands on <first>/oauth/callback
#   admin console → password-reset emails link to <first>/reset-password
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_CONSOLE_ORIGIN=http://localhost:5000
# Extra CORS origins beyond the two apps above (usually empty)
ALLOWED_ORIGIN=

# JWT secret keys
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=

# Redis (host connection: localhost:6379, Redis Insight: http://localhost:5540)
REDIS_URL=redis://localhost:6379

# Email configuration
# Options: 'smtp' (default for local dev with Mailpit) or 'resend' (production)
MAIL_TRANSPORT=smtp
# Mailpit SMTP server: localhost:1025 | Mailpit Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Resend API Key (required if MAIL_TRANSPORT=resend or in production)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=Timmbr <no-reply@timmbr.com>

# Google OAuth (callback must hit the API itself, and be registered in Google Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Storage (Cloudflare R2 / S3 Compatible)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Geoapify reverse geocoding ("use my location" on address forms). Optional.
GEOAPIFY_API_KEY=

# Orders, carts & cron
ORDER_EXPIRATION_TTL_MINUTES=15
GUEST_CART_TTL_DAYS=7
CRON_SECRET=your_secure_cron_secret_here

# Cache Configuration (TTL in seconds)
CACHE_TTL_SECONDS=120

# Proxies in front of the API (load balancer = 1, direct = 0). Used to find the
# visitor's real IP for rate limits. Too high lets clients fake their IP.
TRUST_PROXY=0

# Shared secret for the storefront BFF (server-to-server calls). Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CORE_INTERNAL_KEY=

# Invoice & Seller GST Configuration (Required in production)
INVOICE_SELLER_NAME="Timmbr Retail Private Limited"
INVOICE_SELLER_GSTIN="29AABCT1234F1Z5"
INVOICE_SELLER_ADDRESS="123 MG Road, Indiranagar, Bengaluru, Karnataka - 560038"
INVOICE_SELLER_PHONE="+91 9876543210"
INVOICE_SELLER_EMAIL="billing@timmbr.com"

# Optional Invoice Configuration (defaults in code)
# INVOICE_NUMBER_PREFIX=INV
# INVOICE_REQUIRE_HSN=false
# INVOICE_WORKER_IN_API=false
# INVOICE_DOWNLOAD_URL_TTL_SECONDS=300

# Playwright (Render staging/production — required for invoice PDF generation)
# Must match the path used when `pnpm exec playwright install chromium` runs at build time.
# PLAYWRIGHT_BROWSERS_PATH=/opt/render/project/src/.cache/ms-playwright
