enum BrandStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

model Brand {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  logoUrl     String?
  description String?
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  products Product[]
}
