model ProcessingJob {
  id             String    @id @default(uuid()) @db.Uuid
  jobType        String    @map("job_type") @db.VarChar(50)
  priority       String    @default("NORMAL") @db.VarChar(20)
  status         String    @default("QUEUED") @db.VarChar(30)
  payload        Json      @default("{}")
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(3) @map("max_retries")
  scheduledAt    DateTime? @map("scheduled_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  workerId       String?   @map("worker_id") @db.VarChar(100)
  errorDetails   String?   @map("error_details") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  imports ProductImport[]

  @@index([status, priority], map: "idx_processing_jobs_status_priority")
  @@index([createdAt(sort: Desc)], map: "idx_processing_jobs_created_at")
  @@map("processing_jobs")
}

model ProcessingOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(100)
  streamName  String    @map("stream_name") @db.VarChar(100)
  payload     Json
  status      String    @default("PENDING") @db.VarChar(20)
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error") @db.Text
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("processing_outbox")
}

model ProductImport {
  id               String    @id @default(uuid()) @db.Uuid
  jobId            String?   @map("job_id") @db.Uuid
  fileName         String    @map("file_name") @db.VarChar(255)
  fileKey          String    @map("file_key") @db.VarChar(500)
  fileHash         String    @map("file_hash") @db.VarChar(64)
  fileFormat       String    @map("file_format") @db.VarChar(10)
  mode             String    @default("UPSERT") @db.VarChar(20)
  defaultStatus    String    @default("DRAFT") @map("default_status") @db.VarChar(20)
  defaultInventory Int       @default(25) @map("default_inventory")
  status           String    @default("UPLOADED") @db.VarChar(30)
  totalGroups      Int       @default(0) @map("total_groups")
  processedGroups  Int       @default(0) @map("processed_groups")
  successfulGroups Int       @default(0) @map("successful_groups")
  failedGroups     Int       @default(0) @map("failed_groups")
  warningCount     Int       @default(0) @map("warning_count")
  errorReportKey   String?   @map("error_report_key") @db.VarChar(500)
  createdBy        String    @map("created_by") @db.VarChar(100)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  job    ProcessingJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  groups ProductImportGroup[]
  issues ProductImportIssue[]
  assets ProductImportAsset[]

  @@index([status], map: "idx_product_imports_status")
  @@index([fileHash], map: "idx_product_imports_file_hash")
  @@index([createdBy], map: "idx_product_imports_created_by")
  @@index([createdAt(sort: Desc)], map: "idx_product_imports_created_at")
  @@map("product_imports")
}

model ProductImportGroup {
  id           String    @id @default(uuid()) @db.Uuid
  importId     String    @map("import_id") @db.Uuid
  groupIndex   Int       @map("group_index")
  externalRef  String?   @map("external_ref") @db.VarChar(255)
  slug         String    @db.VarChar(255)
  title        String    @db.VarChar(255)
  status       String    @default("PENDING") @db.VarChar(20)
  action       String    @default("SKIPPED") @db.VarChar(20)
  rowCount     Int       @default(1) @map("row_count")
  productId    String?   @map("product_id") @db.VarChar(100)
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  import ProductImport        @relation(fields: [importId], references: [id], onDelete: Cascade)
  issues ProductImportIssue[]
  assets ProductImportAsset[]

  @@unique([importId, groupIndex], map: "uq_import_group_index")
  @@index([importId, status], map: "idx_product_import_groups_import_status")
  @@index([slug], map: "idx_product_import_groups_slug")
  @@index([externalRef], map: "idx_product_import_groups_external_ref")
  @@map("product_import_groups")
}

model ProductImportIssue {
  id         String   @id @default(uuid()) @db.Uuid
  importId   String   @map("import_id") @db.Uuid
  groupId    String?  @map("group_id") @db.Uuid
  rowNumber  Int      @map("row_number")
  level      String   @default("ERROR") @db.VarChar(10)
  code       String   @db.VarChar(50)
  message    String   @db.Text
  suggestion String?  @db.Text
  field      String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  import ProductImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  group  ProductImportGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([importId], map: "idx_product_import_issues_import")
  @@index([groupId], map: "idx_product_import_issues_group")
  @@index([level], map: "idx_product_import_issues_level")
  @@map("product_import_issues")
}

model ProductImportAsset {
  id               String   @id @default(uuid()) @db.Uuid
  importId         String   @map("import_id") @db.Uuid
  groupId          String?  @map("group_id") @db.Uuid
  sourceUrl        String   @map("source_url") @db.Text
  targetScope      String   @map("target_scope") @db.VarChar(20)
  targetIdentifier String   @map("target_identifier") @db.VarChar(255)
  status           String   @default("PENDING") @db.VarChar(20)
  storageKey       String?  @map("storage_key") @db.VarChar(500)
  fileSize         Int?     @map("file_size")
  mimeType         String?  @map("mime_type") @db.VarChar(100)
  errorMessage     String?  @map("error_message") @db.Text
  attemptCount     Int      @default(0) @map("attempt_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  import ProductImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  group  ProductImportGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([importId], map: "idx_product_import_assets_import")
  @@index([status], map: "idx_product_import_assets_status")
  @@map("product_import_assets")
}

model ProductExternalReference {
  id         String   @id @default(uuid()) @db.Uuid
  source     String   @default("DEFAULT") @db.VarChar(50)
  externalId String   @map("external_id") @db.VarChar(255)
  productId  String   @map("product_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([source, externalId], map: "uq_product_external_ref")
  @@index([productId], map: "idx_product_external_ref_product")
  @@map("product_external_references")
}

