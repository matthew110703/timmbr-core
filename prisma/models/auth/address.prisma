enum AddressType {
    SHIPPING
    BILLING
    BOTH
}

model Address {
    id         String      @id @default(uuid())
    userId     String
    isDefault  Boolean     @default(false)
    firstName  String
    lastName   String
    phone      String
    line1      String
    line2      String?
    city       String
    state      String
    postalCode String
    country    String
    type       AddressType @default(SHIPPING)
    label      String      @default("home")
    latitude   Float?
    longitude  Float?
    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id])
}
