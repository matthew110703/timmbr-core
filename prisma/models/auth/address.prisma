model Address {
    id String @id @default(uuid())
    userId String
    isDefault Boolean 
    firstName String
    lastName String
    phone String
    line1 String
    line2 String?
    city String
    state String
    postalCode String
    country String
    latitude Float
    longitude Float
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id])
}