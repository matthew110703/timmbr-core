enum AttributeType {
  STRING
  INTEGER
  DECIMAL
  LIST
  BOOLEAN
}

/// How a filterable attribute is shown in the storefront filter panel.
enum FilterDisplay {
  CHECKBOX
  SWATCH
  TOGGLE
}

enum AttributeScope {
  PRODUCT
  VARIANT
}

model AttributeDefinition {
  id           String         @id @default(uuid())
  name         String
  type         AttributeType
  unit         String?
  scope        AttributeScope
  isFilterable Boolean        @default(false)
  /// URL key of a filterable global definition (e.g. "material"). Immutable once set.
  key          String?
  displayType  FilterDisplay  @default(CHECKBOX)
  filterOrder  Int            @default(0)
  productId    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  product Product?         @relation(fields: [productId], references: [id])
  values  AttributeValue[]
  options AttributeOption[]

  @@index([productId])
}
